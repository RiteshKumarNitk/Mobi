# Browser-facing API base (baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Public storefront URL: canonical links, Open Graph, sitemap.xml, robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: API base used by the Next.js server (metadata/sitemap) when it differs, e.g. http://api:4000/api in Docker
API_INTERNAL_URL=
