# Public storefront URL used for canonical links, metadata, and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server-side override for metadata and sitemap API calls.
API_INTERNAL_URL=

# Use the existing PostgreSQL database. Prefer its pooled URL on Vercel.
DATABASE_URL="postgresql://user:pass@host:5432/baba?schema=public"
# Preserve the API signing key when moving an existing deployment.
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated browser origins or * for public CORS without credentials.
CORS_ORIGINS=http://localhost:3001
OTP_DEBUG=true
SMS_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
