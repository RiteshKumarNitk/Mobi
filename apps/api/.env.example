# --- Database ---
# PostgreSQL (Neon serverless works great). The schema provider is "postgresql".
# Production schema changes: `npm run db:migrate` (prisma migrate deploy). Never `db push` / `db:reset` on prod.
DATABASE_URL="postgresql://user:pass@host:5432/baba?schema=public"

# --- Server ---
PORT=4000
# Comma-separated allowed browser origins. '*' is accepted in development only;
# production refuses to boot without an explicit list.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Proxies allowed to set X-Forwarded-For (hop count, CIDRs, or "loopback, uniquelocal").
# Default trusts loopback/private networks only. Set 1 behind a single nginx/LB.
TRUST_PROXY=
# Swagger UI at /api/docs. Defaults: on in development, off in production.
API_DOCS_ENABLED=

# --- Auth ---
# Production requires 32+ random characters: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# --- OTP / SMS ---
# Development: true returns the OTP in API responses so flows work without SMS.
# Ignored (always false) when NODE_ENV=production.
OTP_DEBUG=true
# SMS gateway for OTP delivery. Not integrated yet — see docs/KNOWN_LIMITATIONS.md.
SMS_PROVIDER=

# --- Payments (Razorpay) ---
# Without keys: development uses a clearly-labelled mock gateway; production
# DISABLES online payment (COD only). Mock payments can never run in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard → Webhooks (events: payment.captured,
# order.paid, payment.failed, refund.processed) → POST /api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=
# Set false to disable the dev mock gateway even outside production.
ALLOW_MOCK_PAYMENTS=true

# --- Cloudinary (not integrated yet; image URLs are entered manually) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
