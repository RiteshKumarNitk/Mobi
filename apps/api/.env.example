# --- Database ---
# PostgreSQL (Neon serverless works great). The schema provider is "postgresql".
DATABASE_URL="postgresql://user:pass@host:5432/baba?schema=public"

# --- Server ---
PORT=4000
CORS_ORIGINS=* # comma-separated list, or * for all

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# --- OTP / SMS ---
# When true (dev), the generated OTP is returned in the API response so you can
# test without a real SMS gateway. Always false in production.
OTP_DEBUG=true

# --- Payments (Razorpay) ---
# Leave blank to run in mock mode (useful for local dev without keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Cloudinary (optional, used for image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
