{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": {
    "api/index.ts": { "maxDuration": 30, "memory": 1024 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
